# /root/abfahrt/.env  (chmod 600, nie committen). Erzeugen: server/scripts/gen-env.sh <admin1-email> <admin2-email>
ABFAHRT_HOST=abfahrt.askconnect.de

DB_OWNER_PASSWORD=
APP_DB_PASSWORD=

ADMIN_1_EMAIL=
ADMIN_1_PASSWORD=
ADMIN_2_EMAIL=
ADMIN_2_PASSWORD=

# Traefik-Basic-Auth vor /admin* (htpasswd-Format, in einfachen Anführungszeichen wegen der $-Zeichen)
ADMIN_BASIC_AUTH='team:$2y$...'
BASIC_AUTH_USER=team
BASIC_AUTH_PASSWORD=

# Gewinne wie in app/config.js (key:anzahl) und Start der Live-Auslosung (25.10. = Winterzeit → +01:00)
PRIZES=meet:5,shirt:3,drink:5
REVEAL_AT=2026-10-25T04:00:00+01:00
# Optional: DB_POOL_MAX=20  RL_REGISTER_PER_IP_PER_MIN=600  RL_TOKEN_PER_MIN=60
